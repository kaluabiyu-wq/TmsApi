{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5285"
      }
    }
  },
  "Seed": {
    "RunOnStartup": true
  },
  "AllowedOrigins": [
    "http://localhost:4200"
  ],
  "Jwt": {
    "Issuer": "http://localhost:5285",
    "Audience": "tms-client",
    "ExpiryMinutes": 15
  },
  "Certificates": {
    "Storage": {
      "RootPath": "App_Data/certificates"
    },
    "PublicBaseUrl": "http://localhost:4200"
  }
}
